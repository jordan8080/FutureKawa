    {
        "id": "b02ff9834cd52b3f",
        "type": "function",
        "z": "9ab221678fa88320",
        "name": "Alerte_DHT_1",
        "func": "var temp = msg.payload.temp;\nvar humidity = msg.payload.humidity;\n\nvar TEMP_brazil = 29\nvar HUM_brazil = 55\n\n\nmsg.temp = temp;\nmsg.humidity = humidity; \nmsg.alerte = [];\n\nif (temp < TEMP_brazil - 3 ) msg.alerte.push(\"Temp trop basse: \"+ temp +\"°C\");\nif (temp > TEMP_brazil + 3) msg.alerte.push(\"Temp trop haute: \" + temp + \"°C\");\n\nif (humidity < HUM_brazil - 2) msg.alerte.push(\"Hum trop basse: \" + humidity + \"%\");\nif (humidity > HUM_brazil + 2) msg.alerte.push(\"Hum trop haute: \" + humidity + \"%\");\n\nif (msg.alerte.length > 0) {\n    msg.payload = msg.alerte.join(\"\\n\");\n    return msg; \n}\n\nreturn null;\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
